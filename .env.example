# Copie este ficheiro para ".env" e preencha os valores.
# NUNCA coloque o .env real no controlo de versao (ja esta no .gitignore).

# Caminho para o ficheiro JSON da chave da service account (Google Cloud).
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json

# ID da spreadsheet "AppPastoreioGestao" (a parte da URL entre /d/ e /edit).
SPREADSHEET_ID=

# Marco inicial do novo motor de DOMINGO para reconstrução de estado rotacional.
PASTOREIO_DATA_CORTE_HISTORICO=2026-10-01

# Alertas do runner Colaborador. Use uma URL completa de tópico.
# NTFY_TOKEN é opcional para servidores/tópicos protegidos.
NTFY_URL=
NTFY_TOKEN=

# Protecao de quota da Google Sheets no processo Colaborador.
GOOGLE_SHEETS_SHARED_READ_LIMIT=45
GOOGLE_SHEETS_429_MIN_WAIT_SECONDS=65
GOOGLE_SHEETS_MAX_RETRIES=5

# Watchdog e trava contra remocoes anormais.
PASTOREIO_HEALTH_MAX_AGE_SECONDS=900
PASTOREIO_MAX_DELETE_BP_ALGORITIMO=10
